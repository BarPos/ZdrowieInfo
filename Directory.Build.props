<Project>
    <!-- Jedna wersja dla całego rozwiązania. AppVersion.Current musi być zgodne; sprawdza to test. -->
    <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
        <Version>0.1.10</Version>
        <AssemblyVersion>0.1.10.0</AssemblyVersion>
        <FileVersion>0.1.10.0</FileVersion>
        <InformationalVersion>0.1.10</InformationalVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
</Project>
