<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- Zależność przechodnia z wyższą wersją niż przypięta tutaj = błąd, a nie cicha zmiana linii. -->
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup>
        <!-- Dane -->
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
        <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
        <!-- Host i konta -->
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.15" />
        <PackageVersion Include="QRCoder" Version="1.8.1" />
        <!-- Źródła -->
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
        <PackageVersion Include="AngleSharp" Version="1.10.4" />
        <PackageVersion Include="MimeKitLite" Version="4.18.1" />
        <PackageVersion Include="DiffPlex" Version="1.9.0" />
        <PackageVersion Include="Cronos" Version="0.13.0" />
        <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
        <!-- Raporty -->
        <PackageVersion Include="Anthropic" Version="13.10.0" />
        <PackageVersion Include="Markdig" Version="1.6.0" />
        <PackageVersion Include="Scriban" Version="7.6.1" />
        <!-- Push -->
        <PackageVersion Include="WebPush" Version="1.0.13" />
        <!-- MCP -->
        <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
        <!-- UI (tylko panel) -->
        <PackageVersion Include="MudBlazor" Version="9.14.0" />
        <!-- Testy -->
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    </ItemGroup>
</Project>
