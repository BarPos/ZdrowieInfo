# /etc/zdrowieinfo/zdrowieinfo.env – czytany przez systemd (tylko root, chmod 600).
# Kestrel nasłuchuje lokalnie; HTTPS zapewnia reverse proxy.
ASPNETCORE_URLS=http://127.0.0.1:5180

# Publiczny adres aplikacji (https, bez ścieżki). Zmiana domeny: patrz README.
ZdrowieInfo__PublicUrl=https://zdrowieinfo.example.pl
ZdrowieInfo__DataDirectory=/var/lib/zdrowieinfo

# Jeśli reverse proxy działa na innej maszynie: jej adres IP (i ASPNETCORE_URLS=http://0.0.0.0:5180).
# ZdrowieInfo__TrustedProxies__0=10.0.0.5

# Adres kontaktowy w User-Agencie (dla administratorów monitorowanych stron); puste = bez adresu.
# ZdrowieInfo__Sources__ContactEmail=

# PDF raportów: latexmk (TeX Live z apt, domyślnie) albo tectonic. Własna formatka: ścieżka do pliku .tex.scriban.
# ZdrowieInfo__Export__Compiler=latexmk
# ZdrowieInfo__Export__TemplatePath=/var/lib/zdrowieinfo/report.tex.scriban   (plik czytelny dla użytkownika zdrowieinfo)

ConnectionStrings__ZdrowieInfo=Host=localhost;Database=zdrowieinfo;Username=zdrowieinfo;Password=ZMIEN
