@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using ZdrowieInfo.Server.Data

@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Zmiana hasła – ZdrowieInfo</PageTitle>

<h2>Zmiana hasła</h2>
<StatusMessage Message="@message" />
<p class="muted">Zmiana hasła wylogowuje pozostałe urządzenia (także zainstalowaną aplikację na telefonie) w ciągu 5 minut.</p>
<EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post" class="narrow">
    <DataAnnotationsValidator />
    <div class="field">
        <label for="Input.OldPassword">Obecne hasło</label>
        <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" autocomplete="current-password" />
        <ValidationMessage For="() => Input.OldPassword" class="error" />
    </div>
    <div class="field">
        <label for="Input.NewPassword">Nowe hasło (min. 12 znaków)</label>
        <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.NewPassword" class="error" />
    </div>
    <div class="field">
        <label for="Input.ConfirmPassword">Powtórz nowe hasło</label>
        <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" autocomplete="new-password" />
        <ValidationMessage For="() => Input.ConfirmPassword" class="error" />
    </div>
    <button type="submit" class="btn btn-primary">Zmień hasło</button>
</EditForm>

@code {
    private string? message;
    private AppUser? user;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null) RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            message = $"Błąd: {string.Join(" ", result.Errors.Select(e => e.Description))}";
            return;
        }

        // ChangePasswordAsync zmienia security stamp – inne sesje wygasną; bieżącą odświeżamy.
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("Użytkownik {UserName} zmienił hasło.", user.UserName);
        RedirectManager.RedirectToCurrentPageWithStatus("Hasło zostało zmienione.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Podaj obecne hasło.")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Podaj nowe hasło.")]
        [StringLength(200, MinimumLength = 12, ErrorMessage = "Hasło musi mieć co najmniej 12 znaków.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "Hasła nie są takie same.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
