@page "/"
@using Microsoft.EntityFrameworkCore
@using ZdrowieInfo.Server.Data
@using ZdrowieInfo.Server.Reports
@inject IDbContextFactory<ZdrowieInfoDbContext> DbFactory

<PageTitle>Raporty – ZdrowieInfo</PageTitle>

<h1>Raporty</h1>
<form method="get" action="szukaj" class="search-box home-search">
    <input type="search" name="q" placeholder="Szukaj w raportach…" aria-label="Szukaj w raportach" />
    <button type="submit" class="btn">Szukaj</button>
</form>
@if (!string.IsNullOrEmpty(Deleted))
{
    <p class="notice">Usunięto raport @Deleted.</p>
}
@if (rows.Count == 0 && page == 1)
{
    <section class="card">
        <p>Nie ma jeszcze raportów. Raport powstaje rano (przed 6:30) za poprzedni dzień – pierwszy po pełnym dniu sprawdzania źródeł.</p>
    </section>
}
else
{
    <ul class="report-list">
        @foreach (var r in rows)
        {
            <li>
                <a href="raporty/@r.Key.Slug" class="report-row @(r.IsEmpty ? "empty" : "")">
                    <span class="report-date">@(r.Key.Kind == ReportKind.Daily ? r.Key.End.ToString("ddd d.MM") : r.Key.Label)</span>
                    <span class="report-title">@r.Title</span>
                    <span class="report-badges">
                        @if (r.Key.Kind == ReportKind.Period) { <span class="badge muted">okresowy</span> }
                        @if (r.Critical > 0) { <span class="badge critical">@r.Critical krytyczne</span> }
                        @if (r.High > 0) { <span class="badge high">@r.High wysokie</span> }
                        @if (r.Status == ReportStatus.NeedsReview) { <span class="badge warn">do weryfikacji</span> }
                        @if (r.Status == ReportStatus.AiError) { <span class="badge warn">bez analizy</span> }
                        @if (r.IsEmpty) { <span class="badge muted">brak zmian</span> }
                        @if (r.SourceProblems > 0) { <span class="badge warn">źródła: @r.SourceProblems</span> }
                    </span>
                </a>
            </li>
        }
    </ul>
    <Pager Page="page" HasMore="hasMore" TotalPages="totalPages" />
}

@code {
    private const int PageSize = 30;

    private sealed record Row(ReportKey Key, string Title, bool IsEmpty, ReportStatus Status, int Critical, int High, int SourceProblems);

    [SupplyParameterFromQuery(Name = Pager.Parameter)] private int? Strona { get; set; }
    [SupplyParameterFromQuery(Name = "usunieto")] private string? Deleted { get; set; }

    private List<Row> rows = [];
    private int page = 1;
    private bool hasMore;
    private int totalPages;

    protected override async Task OnParametersSetAsync()
    {
        page = Pager.Normalize(Strona);
        await using var db = await DbFactory.CreateDbContextAsync();
        var total = await db.Reports.CountAsync();
        totalPages = Math.Max(1, (total + PageSize - 1) / PageSize);
        // Najnowsze na górze; raport okresowy według ostatniego dnia okresu, za dziennym z tego dnia.
        var reports = await db.Reports.AsNoTracking()
            .OrderByDescending(r => r.Date).ThenBy(r => r.Kind).ThenByDescending(r => r.PeriodStart)
            .Skip((page - 1) * PageSize).Take(PageSize)
            .Select(r => new
            {
                r.Kind, r.PeriodStart, r.Date, r.Title, r.IsEmpty, r.Status, r.SourcesState,
                Critical = r.Findings.Count(f => f.Importance == Importance.Critical),
                High = r.Findings.Count(f => f.Importance == Importance.High),
            }).ToListAsync();
        rows = reports.Select(r => new Row(new ReportKey(r.Kind, r.PeriodStart, r.Date), r.Title, r.IsEmpty, r.Status, r.Critical, r.High,
            r.SourcesState.Count(s => !s.Ok || s.Warning != null))).ToList();
        hasMore = page < totalPages;
    }
}
