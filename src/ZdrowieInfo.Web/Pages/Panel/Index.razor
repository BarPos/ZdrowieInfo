@page "/panel"
@rendermode InteractiveServer
@using ZdrowieInfo.Server.Common
@inject WarsawClock Clock
@inject ISnackbar Snackbar

<PageTitle>Panel – ZdrowieInfo</PageTitle>

<AdminShell>
    <MudText Typo="Typo.h4" Class="mb-4">Panel</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle2">Wersja</MudText>
                <MudText Typo="Typo.h6">@AppVersion.Current</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle2">Czas serwera (Warszawa)</MudText>
                <MudText Typo="Typo.h6">@Clock.LocalNow.ToString("dddd, d MMMM yyyy, HH:mm")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
    <MudAlert Severity="Severity.Info" Class="mt-4">
        Źródła, uruchomienia, klucze API i ustawienia pojawią się tu w kolejnych etapach.
    </MudAlert>
    <MudButton Class="mt-4" Variant="Variant.Outlined" OnClick="Ping">Sprawdź połączenie z panelem</MudButton>
</AdminShell>

@code {
    private void Ping() => Snackbar.Add("Panel działa interaktywnie.", Severity.Success);
}
