@page "/panel/wpisy-wlasne"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.EntityFrameworkCore
@using ZdrowieInfo.Server.Common
@using ZdrowieInfo.Server.Data
@using ZdrowieInfo.Server.Entries
@inject IDbContextFactory<ZdrowieInfoDbContext> DbFactory
@inject UserEntryService Entries
@inject WarsawClock Clock
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Wpisy własne – ZdrowieInfo</PageTitle>

<AdminShell>
    <MudText Typo="Typo.h4" Class="mb-2">Wpisy własne</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        Komunikaty spoza monitorowanych stron, np. jawne ostrzeżenia CSIRT MON z poczty. Wpis trafia do najbliższego raportu
        dziennego, który obejmuje jego datę – z dzisiejszą datą do jutrzejszego porannego raportu. Treść jest wysyłana do Claude API
        (i do sprawdzania podatności w internecie, jeśli jest włączone), więc wklejaj tylko komunikaty jawne.
    </MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">@(editingId is null ? "Nowy wpis" : "Edycja wpisu")</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="origin" Label="Źródło" Placeholder="np. CSIRT MON" MaxLength="200" />
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudTextField T="string" @bind-Value="title" Label="Tytuł komunikatu" MaxLength="500" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Data publikacji" @bind-Date="published" MaxDate="Today" DateFormat="dd.MM.yyyy" />
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Treść komunikatu</MudText>
        <div class="rt">
            <div class="rt-toolbar" @ref="toolbar">
                <button type="button" data-cmd="bold" title="Pogrubienie"><b>B</b></button>
                <button type="button" data-cmd="italic" title="Kursywa"><i>I</i></button>
                <button type="button" data-cmd="h3" title="Nagłówek">Nagłówek</button>
                <button type="button" data-cmd="p" title="Zwykły akapit">Akapit</button>
                <button type="button" data-cmd="insertUnorderedList" title="Lista punktowana">• Lista</button>
                <button type="button" data-cmd="insertOrderedList" title="Lista numerowana">1. Lista</button>
                <button type="button" data-cmd="table" title="Wstaw tabelę 2×2">Tabela</button>
                <button type="button" data-cmd="removeFormat" title="Usuń formatowanie zaznaczenia">Wyczyść</button>
            </div>
            @* Pusty w drzewie Blazora – treścią zarządza richtext.js. *@
            <div class="rt-editor" contenteditable="true" @ref="editor" role="textbox" aria-multiline="true" aria-label="Treść komunikatu"></div>
        </div>
        <MudText Typo="Typo.caption" Class="mt-1">Wklej komunikat z poczty albo strony – tabele, listy i pogrubienia zostają. Obrazy, style i skrypty są usuwane.</MudText>

        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="saving" OnClick="Save">@(editingId is null ? "Dodaj wpis" : "Zapisz zmiany")</MudButton>
            @if (editingId is not null)
            {
                <MudButton Variant="Variant.Text" Disabled="saving" OnClick="CancelEdit">Anuluj edycję</MudButton>
            }
        </MudStack>
    </MudPaper>

    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
        <MudTextField T="string" Value="search" ValueChanged="SearchChanged" Label="Szukaj w tytule i źródle" DebounceInterval="300"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Style="min-width:260px" />
        <MudSelect T="string" Value="originFilter" ValueChanged="OriginChanged" Label="Źródło" Clearable="true" Style="min-width:200px" Dense="true">
            @foreach (var o in origins)
            {
                <MudSelectItem T="string" Value="o">@o</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="StateFilter" Value="state" ValueChanged="StateChanged" Label="Stan" Style="min-width:180px" Dense="true">
            <MudSelectItem T="StateFilter" Value="StateFilter.All">wszystkie</MudSelectItem>
            <MudSelectItem T="StateFilter" Value="StateFilter.Pending">czeka na raport</MudSelectItem>
            <MudSelectItem T="StateFilter" Value="StateFilter.Reported">w raporcie</MudSelectItem>
        </MudSelect>
    </MudStack>

    <MudDataGrid @ref="grid" T="Row" ServerData="LoadServerData" Dense="true" Hover="true" SortMode="SortMode.None" Filterable="false" ShowColumnOptions="false">
        <NoRecordsContent><MudText>@(Filtered ? "Brak wpisów spełniających warunki." : "Nie ma jeszcze wpisów własnych.")</MudText></NoRecordsContent>
        <Columns>
            <PropertyColumn Property="r => Labels.Date(r.PublishedOn)" Title="Data" />
            <PropertyColumn Property="r => r.Origin" Title="Źródło" />
            <TemplateColumn Title="Tytuł">
                <CellTemplate><MudLink Href="@($"wpisy-wlasne/{context.Item.Id}")">@context.Item.Title</MudLink></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Stan">
                <CellTemplate>
                    @if (context.Item.ReportedAt is null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">czeka na raport</MudChip>
                    }
                    else if (context.Item.ReportSlug is { } slug)
                    {
                        <MudLink Href="@($"raporty/{slug}")">w raporcie @context.Item.ReportLabel</MudLink>
                    }
                    else
                    {
                        <span>zaraportowany</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="r => r.CreatedBy" Title="Dodał" />
            <TemplateColumn>
                <CellTemplate>
                    <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd" Style="white-space:nowrap">
                        @if (context.Item.ReportedAt is not null)
                        {
                            <MudTooltip Text="Przywróć jako niezaraportowany">
                                <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" aria-label="Przywróć jako niezaraportowany" OnClick="() => Release(context.Item)" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Edytuj">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edytuj" OnClick="() => Edit(context.Item.Id)" />
                            </MudTooltip>
                            <MudTooltip Text="Usuń">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Usuń" OnClick="() => Delete(context.Item)" />
                            </MudTooltip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Row" PageSizeOptions="[25, 50, 100]" RowsPerPageString="Wierszy na stronę:" />
        </PagerContent>
    </MudDataGrid>
</AdminShell>

@code {
    private sealed record Row(long Id, DateOnly? PublishedOn, string Origin, string Title, DateTimeOffset? ReportedAt, string? CreatedBy, string? ReportSlug, string? ReportLabel);

    private enum StateFilter { All, Pending, Reported }

    private ElementReference editor, toolbar;
    private IJSObjectReference? module;
    private MudDataGrid<Row>? grid;
    private List<string> origins = [];
    private string? search, originFilter;
    private StateFilter state = StateFilter.All;
    private string origin = "", title = "", login = "";
    private DateTime? published;
    private long? editingId;
    private bool saving;

    private DateTime Today => Clock.Today.ToDateTime(TimeOnly.MinValue);

    protected override async Task OnInitializedAsync()
    {
        login = (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
        published = Today;
        await LoadOriginsAsync();
    }

    private bool Filtered => !string.IsNullOrWhiteSpace(search) || originFilter is not null || state != StateFilter.All;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Specyfikator modułu musi być względny („./”), inaczej przeglądarka go nie rozwiąże.
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["_content/ZdrowieInfo.Web/js/richtext.js"]);
        await module.InvokeVoidAsync("init", editor, toolbar, "");
    }

    private async Task LoadOriginsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        origins = await UserEntryService.Mine(db).Where(i => i.Origin != null).Select(i => i.Origin!).Distinct().OrderBy(o => o).ToListAsync();
    }

    /// <summary>Lista i filtry po stronie bazy (stronicowanie jak w pozostałych tabelach panelu).</summary>
    private async Task<GridData<Row>> LoadServerData(GridState<Row> gridState, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        var query = UserEntryService.Mine(db).AsNoTracking();
        if (!string.IsNullOrWhiteSpace(search))
        {
            var pattern = "%" + search.Trim().Replace("\\", "\\\\").Replace("%", "\\%").Replace("_", "\\_") + "%";
            query = query.Where(i => EF.Functions.ILike(i.Title, pattern) || EF.Functions.ILike(i.Origin!, pattern));
        }
        if (originFilter is not null) query = query.Where(i => i.Origin == originFilter);
        if (state == StateFilter.Pending) query = query.Where(i => i.ReportedAt == null);
        if (state == StateFilter.Reported) query = query.Where(i => i.ReportedAt != null);

        var total = await query.CountAsync(ct);
        var items = await query.OrderByDescending(i => i.FirstSeenAt).ThenByDescending(i => i.Id)
            .Skip(gridState.Page * gridState.PageSize).Take(gridState.PageSize)
            .Select(i => new { i.Id, i.PublishedOn, i.Origin, i.Title, i.ReportedAt, i.CreatedBy, i.ReportId })
            .ToListAsync(ct);
        var reportIds = items.Where(i => i.ReportId != null).Select(i => i.ReportId!.Value).Distinct().ToList();
        var keys = (await db.Reports.AsNoTracking().Where(r => reportIds.Contains(r.Id))
                .Select(r => new { r.Id, r.Kind, r.PeriodStart, r.Date }).ToListAsync(ct))
            .ToDictionary(r => r.Id, r => new ZdrowieInfo.Server.Reports.ReportKey(r.Kind, r.PeriodStart, r.Date));
        return new GridData<Row>
        {
            TotalItems = total,
            Items = items.Select(i =>
            {
                var key = i.ReportId is { } id && keys.TryGetValue(id, out var k) ? k : (ZdrowieInfo.Server.Reports.ReportKey?)null;
                return new Row(i.Id, i.PublishedOn, i.Origin ?? "", i.Title, i.ReportedAt, i.CreatedBy, key?.Slug, key?.Label);
            }).ToList(),
        };
    }

    private async Task LoadAsync()
    {
        await LoadOriginsAsync();
        if (grid is not null) await grid.ReloadServerData();
    }

    private Task SearchChanged(string? value) { search = value; return Reload(); }
    private Task OriginChanged(string? value) { originFilter = value; return Reload(); }
    private Task StateChanged(StateFilter value) { state = value; return Reload(); }
    // Nowy filtr – od pierwszej strony (inaczej można zostać na stronie, której już nie ma).
    private async Task Reload()
    {
        if (grid is null) return;
        grid.NavigateTo(Page.First);
        await grid.ReloadServerData();
    }

    private async Task Save()
    {
        if (module is null || published is null) return;
        saving = true;
        try
        {
            var html = await module.InvokeAsync<string>("getHtml", editor);
            var input = new UserEntryInput(origin, title, html, DateOnly.FromDateTime(published.Value));
            var result = editingId is { } id ? await Entries.UpdateAsync(id, input) : await Entries.CreateAsync(input, login);
            if (!result.Ok)
            {
                Snackbar.Add(result.Error ?? "Nie udało się zapisać wpisu.", Severity.Error);
                return;
            }
            Snackbar.Add(editingId is null ? "Dodano wpis – trafi do najbliższego raportu." : "Zapisano zmiany.", Severity.Success);
            editingId = null;
            title = "";
            published = Today;
            await module.InvokeVoidAsync("setHtml", editor, "");
            await LoadAsync();
        }
        catch (JSException e)
        {
            Snackbar.Add($"Nie udało się odczytać treści z edytora: {e.Message}", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Edit(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var item = await UserEntryService.Mine(db).AsNoTracking().SingleOrDefaultAsync(i => i.Id == id);
        if (item is null || module is null) return;
        editingId = id;
        origin = item.Origin ?? "";
        title = item.Title;
        published = item.PublishedOn?.ToDateTime(TimeOnly.MinValue) ?? Today;
        await module.InvokeVoidAsync("setHtml", editor, item.ContentHtml ?? "");
    }

    private async Task CancelEdit()
    {
        editingId = null;
        title = "";
        published = Today;
        if (module is not null) await module.InvokeVoidAsync("setHtml", editor, "");
    }

    private async Task Release(Row row)
    {
        var report = row.ReportLabel is { } label ? $"Raport {label} zostaje bez zmian, a wpis" : "Wpis";
        if (await Dialogs.ShowMessageBoxAsync("Przywrócić wpis jako niezaraportowany?",
                $"{report} „{row.Title}” trafi do najbliższego raportu dziennego (albo do ponownie przygotowanego raportu za wczoraj lub dziś). Znów będzie można go zmienić albo usunąć.",
                yesText: "Przywróć", cancelText: "Anuluj") != true) return;
        var result = await Entries.ReleaseAsync(row.Id);
        Snackbar.Add(result.Ok ? "Wpis czeka na raport." : result.Error ?? "Nie udało się przywrócić wpisu.", result.Ok ? Severity.Success : Severity.Error);
        await LoadAsync();
    }

    private async Task Delete(Row row)
    {
        if (await Dialogs.ShowMessageBoxAsync("Usunąć wpis?", $"Wpis „{row.Title}” zostanie usunięty. Tego nie da się cofnąć.",
                yesText: "Usuń", cancelText: "Anuluj") != true) return;
        var result = await Entries.DeleteAsync(row.Id);
        Snackbar.Add(result.Ok ? "Usunięto wpis." : result.Error ?? "Nie udało się usunąć wpisu.", result.Ok ? Severity.Success : Severity.Error);
        if (editingId == row.Id) await CancelEdit();
        await LoadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
