@page "/raporty/{Day}"
@using Microsoft.EntityFrameworkCore
@using ZdrowieInfo.Server.Common
@using ZdrowieInfo.Server.Data
@using ZdrowieInfo.Server.Reports
@using ZdrowieInfo.Server.Accounts
@using Microsoft.Extensions.Options
@inject IDbContextFactory<ZdrowieInfoDbContext> DbFactory
@inject IOptions<ZdrowieInfoOptions> AppOptions

@if (view is null)
{
    <PageTitle>Nie ma raportu – ZdrowieInfo</PageTitle>
    <h1>Nie ma takiego raportu</h1>
    <p><a href="">Wróć do listy raportów</a>.</p>
}
else
{
    var r = view.Report;
    var section = 0;
    <PageTitle>@r.Title – ZdrowieInfo</PageTitle>

    <nav class="doc-toolbar" aria-label="Nawigacja raportu">
        <span class="doc-pager">
            @if (view.Previous is { } prev) { <a href="raporty/@prev.Slug" title="Poprzedni raport">← @ShortLabel(prev)</a> }
            <a href="">Wszystkie</a>
            @if (view.Next is { } next) { <a href="raporty/@next.Slug" title="Następny raport">@ShortLabel(next) →</a> }
        </span>
        <AuthorizeView Policy="@AppRoles.AdminPolicy" Context="admin">
            <span class="doc-downloads">
                <a class="btn btn-primary" href="eksport/raport-@(r.Key.Slug).pdf" target="_blank" rel="noopener" data-enhance-nav="false">Pobierz PDF</a>
                <a class="btn" href="raporty/@(r.Key.Slug)#udostepnianie" data-enhance-nav="false">Udostępnij…</a>
            </span>
        </AuthorizeView>
    </nav>

    <article class="doc">
        <header class="doc-head">
            <p class="doc-kicker">ZdrowieInfo · @view.KindLabel</p>
            <h1>@r.Title</h1>
            <p class="doc-date">@view.DateLong</p>
            <table class="doc-meta">
                <tr><th>Przygotował</th><td>@view.ProducerLabel</td></tr>
                <tr><th>Punkty</th><td>@r.Findings.Count@(Critical > 0 ? $" (krytyczne: {Critical})" : "")</td></tr>
                <tr><th>Wpisy źródłowe</th><td>@view.Entries.Count</td></tr>
                @if (view.HasSourcesState)
                {
                <tr><th>Źródła</th><td>sprawdzone w tym dniu @view.SourcesChecked z @r.SourcesState.Count@(view.SourceProblems.Count > 0 ? $", z uwagami: {view.SourceProblems.Count}" : "")</td></tr>
                }
            </table>
            @if (view.StatusNote is not null)
            {
                <p class="doc-note @(r.Status == ReportStatus.AiError ? "error" : "")">@view.StatusNote</p>
            }
        </header>

        <section>
            <h2><span class="doc-num">@(++section).</span> Podsumowanie</h2>
            <p class="doc-lead">@r.Summary</p>
        </section>

        @if (view.Groups.Count > 0)
        {
            <section>
                <h2><span class="doc-num">@(++section).</span> Ustalenia</h2>
                    @foreach (var f in view.Findings)
                    {
                        <div class="doc-finding">
                            <p class="doc-imp importance-@f.Finding.Importance.ToString().ToLowerInvariant()">@f.Importance</p>
                            <p class="doc-cat">@f.Category</p>
                            <h4><span class="doc-num">@f.Number.</span> @f.Finding.Headline</h4>
                            <p>@f.Finding.Body</p>
                            @if (f.Finding.Action is not null)
                            {
                                <p class="doc-action"><strong>Do zrobienia:</strong> @f.Finding.Action</p>
                            }
                            @foreach (var c in f.Citations)
                            {
                                <blockquote class="doc-quote @(c.Citation.Verified ? "" : "unverified")">
                                    „@c.Citation.Quote”<sup class="doc-fn"><a href="raporty/@view.Report.Key.Slug#przypis-@c.Footnote" id="odwolanie-@c.Footnote" data-enhance-nav="false">@c.Footnote</a></sup>
                                </blockquote>
                            }
                        </div>
                    }
            </section>
        }

        @if (view.Research is { } research)
        {
            <section>
                <h2><span class="doc-num">@(++section).</span> Szczegóły podatności z internetu</h2>
                <p class="doc-muted">Sprawdzone automatycznie w internecie przed analizą (liczba wyszukiwań: @research.Searches). Nie pochodzą z monitorowanych źródeł i nie są objęte sprawdzaniem cytatów.</p>
                <div class="doc-research">@research.Notes</div>
                @if (research.Sources.Count > 0)
                {
                    <p class="doc-muted">Źródła:</p>
                    <ul class="doc-list">
                        @foreach (var s in research.Sources)
                        {
                            <li><a href="@s.Url" target="_blank" rel="noopener nofollow">@s.Title</a></li>
                        }
                    </ul>
                }
            </section>
        }

        @if (r.Status == ReportStatus.AiError && view.Entries.Count > 0)
        {
            <section>
                <h2><span class="doc-num">@(++section).</span> Wykryte wpisy (bez analizy)</h2>
                <ol class="doc-list">
                    @foreach (var e in view.Entries)
                    {
                        <li><a href="@e.Url" target="_blank" rel="noopener">@e.Title</a> <span class="doc-muted">(@e.Source@(e.PublishedOn is { } d ? $", {d:dd.MM.yyyy}" : ""))</span></li>
                    }
                </ol>
            </section>
        }

        @if (view.Ignored.Count > 0)
        {
            <section>
                <h2><span class="doc-num">@(++section).</span> Pominięte wpisy</h2>
                <p class="doc-muted">Wpisy uznane za nieistotne dla przychodni – z powodem, żeby można było sprawdzić, czy nic ważnego nie zostało odrzucone.</p>
                <ul class="doc-list">
                    @foreach (var i in view.Ignored)
                    {
                        <li>
                            @if (i.Url is not null) { <a href="@i.Url" target="_blank" rel="noopener">@i.Title</a> } else { @i.Title }
                            <span class="doc-muted">– @i.Reason</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (view.HasSourcesState)
        {
        <section>
            <h2><span class="doc-num">@(++section).</span> Stan źródeł</h2>
            @if (view.SourceProblems.Count == 0)
            {
                <p>Wszystkie @r.SourcesState.Count źródeł bez problemów (sprawdzone w tym dniu: @view.SourcesChecked; pozostałe według swojej częstotliwości).</p>
            }
            else
            {
                <p>Bez problemów: @(r.SourcesState.Count - view.SourceProblems.Count) z @r.SourcesState.Count. Uwagi:</p>
                <ul class="doc-list">
                    @foreach (var s in view.SourceProblems)
                    {
                        <li><a href="@s.Url" target="_blank" rel="noopener"><strong>@s.Name</strong></a>: @(s.Problem ?? s.Warning)</li>
                    }
                </ul>
            }
            @foreach (var line in view.Recoveries)
            {
                <p class="doc-muted">@line</p>
            }
        </section>
        }

        @if (r.Status != ReportStatus.AiError && view.Entries.Count > 0)
        {
            <section>
                <h2><span class="doc-num">@(++section).</span> Wpisy źródłowe</h2>
                <ol class="doc-list doc-small">
                    @foreach (var e in view.Entries)
                    {
                        <li><a href="@e.Url" target="_blank" rel="noopener">@e.Title</a> <span class="doc-muted">(@e.Source@(e.PublishedOn is { } d ? $", {d:dd.MM.yyyy}" : ""))</span></li>
                    }
                </ol>
            </section>
        }

        @if (view.Footnotes.Count > 0)
        {
            <section class="doc-footnotes">
                <h2>Przypisy</h2>
                <ol>
                    @foreach (var n in view.Footnotes)
                    {
                        <li id="przypis-@n.Number">
                            @n.Title@(n.PublishedOn is { } d ? $", {d:dd.MM.yyyy}" : "")@(n.Verified ? "" : " (cytat niezweryfikowany)").
                            @if (!string.IsNullOrEmpty(n.Url)) { <a href="@n.Url" target="_blank" rel="noopener">@n.Url</a> }
                            <a href="raporty/@view.Report.Key.Slug#odwolanie-@n.Number" class="doc-back" aria-label="Wróć do cytatu" data-enhance-nav="false">↩</a>
                        </li>
                    }
                </ol>
            </section>
        }

        <footer class="doc-foot">
            Wygenerowano @WarsawClock.ToLocal(r.CreatedAt).ToString("dd.MM.yyyy HH:mm") przez ZdrowieInfo z publicznych komunikatów NFZ, CeZ, MZ i CSIRT CeZ.
            Cytaty są automatycznie porównywane z treścią źródeł.
            @if (r.PdfError is not null) { <br /><span class="doc-muted">PDF: ostatnia kompilacja nieudana – zostanie ponowiona przy pobraniu.</span> }
        </footer>
    </article>

    <AuthorizeView Policy="@AppRoles.AdminPolicy" Context="admin">
        <section class="card doc-admin" id="udostepnianie">
            <h2>Udostępnianie i zarządzanie</h2>
            @if (LinkStatus is { } status)
            {
                <p class="notice">@(status switch { "udostepniono" => "Link utworzony.", "nowy-link" => "Utworzono nowy link – poprzedni już nie działa.", "wycofano" => "Udostępnienie wycofane – link już nie działa.", _ => "" })</p>
            }
            @if (r.ShareToken is { } token)
            {
                var url = $"{AppOptions.Value.PublicUrl.TrimEnd('/')}/udostepnione/{token}";
                <p>PDF raportu jest dostępny pod publicznym linkiem (bez logowania, dla każdego, kto go zna) od @WarsawClock.ToLocal(r.SharedAt!.Value).ToString("dd.MM.yyyy HH:mm"):</p>
                <p><input class="share-link" type="text" readonly value="@url" aria-label="Publiczny link do PDF" onfocus="this.select()" /></p>
                <div class="actions">
                    <form method="post" action="raporty/@(r.Key.Slug)/nowy-link" data-enhance="false"><AntiforgeryToken /><button type="submit" class="btn">Nowy losowy link</button></form>
                    <form method="post" action="raporty/@(r.Key.Slug)/wycofaj" data-enhance="false"><AntiforgeryToken /><button type="submit" class="btn">Wycofaj udostępnienie</button></form>
                </div>
            }
            else
            {
                <p>Raport nie jest udostępniony. Publiczny link pozwala otworzyć PDF raportu bez logowania; można go w każdej chwili wycofać albo zastąpić nowym.</p>
                <form method="post" action="raporty/@(r.Key.Slug)/udostepnij" data-enhance="false"><AntiforgeryToken /><button type="submit" class="btn btn-primary">Utwórz publiczny link do PDF</button></form>
            }
            <details class="danger-zone">
                <summary>Usuń raport</summary>
                <p>Raport, jego PDF i publiczny link zostaną usunięte. Wpisy źródłowe zostają (nie wrócą do raportu dziennego).
                    @if (r.Kind == ReportKind.Daily) { <text>Raport można przygotować ponownie w <a href="panel/raporty" data-enhance-nav="false">Panel → Raporty</a>.</text> }</p>
                <form method="post" action="raporty/@(r.Key.Slug)/usun" data-enhance="false"><AntiforgeryToken /><button type="submit" class="btn btn-danger">Usuń raport @r.Key.Label</button></form>
            </details>
        </section>
    </AuthorizeView>
}

@code {
    [Parameter] public string Day { get; set; } = "";

    [SupplyParameterFromQuery(Name = "link")] private string? LinkStatus { get; set; }

    private static string ShortLabel(ReportKey key) => key.Kind == ReportKind.Daily ? key.End.ToString("d.MM") : key.Label;

    private ReportView? view;

    private int Critical => view?.Report.Findings.Count(f => f.Importance == Importance.Critical) ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        view = null;
        if (!ReportKey.TryParse(Day, out var key)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        view = await ReportView.LoadAsync(db, key);
    }
}
