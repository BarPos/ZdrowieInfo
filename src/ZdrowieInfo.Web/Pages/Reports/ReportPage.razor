@page "/raporty/{Day}"
@using Microsoft.EntityFrameworkCore
@using ZdrowieInfo.Server.Common
@using ZdrowieInfo.Server.Data
@using ZdrowieInfo.Server.Reports
@using ZdrowieInfo.Server.Sources
@inject IDbContextFactory<ZdrowieInfoDbContext> DbFactory
@inject NavigationManager Nav

@if (report is null)
{
    <PageTitle>Nie ma raportu – ZdrowieInfo</PageTitle>
    <h1>Nie ma raportu na ten dzień</h1>
    <p><a href="">Wróć do listy raportów</a>.</p>
}
else
{
    <PageTitle>@report.Title – ZdrowieInfo</PageTitle>

    <nav class="report-nav">
        @if (previousDay is not null) { <a href="raporty/@previousDay.Value.ToString("yyyy-MM-dd")">← @previousDay.Value.ToString("d.MM")</a> } else { <span></span> }
        <a href="">Wszystkie raporty</a>
        @if (nextDay is not null) { <a href="raporty/@nextDay.Value.ToString("yyyy-MM-dd")">@nextDay.Value.ToString("d.MM") →</a> } else { <span></span> }
    </nav>

    <h1>@report.Title</h1>
    <p class="muted">@report.Date.ToString("dddd, d MMMM yyyy")</p>

    @if (report.Status == ReportStatus.NeedsReview)
    {
        <div class="alert alert-warn">
            <strong>Do weryfikacji.</strong> Automatyczna kontrola znalazła uwagi – sprawdź oznaczone cytaty w źródłach.
            @if (report.ValidationIssues.Count > 0)
            {
                <details><summary>Uwagi (@report.ValidationIssues.Count)</summary><ul>@foreach (var i in report.ValidationIssues) { <li>@i</li> }</ul></details>
            }
        </div>
    }
    @if (report.Status == ReportStatus.AiError)
    {
        <div class="alert alert-error"><strong>Bez analizy.</strong> @report.Error</div>
    }

    <p class="summary">@report.Summary</p>

    @foreach (var group in report.Findings.OrderBy(f => f.Order).GroupBy(f => f.Importance).OrderBy(g => g.Key))
    {
        <section class="findings importance-@group.Key.ToString().ToLowerInvariant()">
            <h2>@ImportanceHeading(group.Key) <span class="count">@group.Count()</span></h2>
            @foreach (var f in group)
            {
                <article class="finding">
                    <p class="category">@ReportVocabulary.Label(f.Category)</p>
                    <h3>@f.Headline</h3>
                    <p>@f.Body</p>
                    @if (f.Action is not null)
                    {
                        <p class="action"><strong>Do zrobienia:</strong> @f.Action</p>
                    }
                    @foreach (var c in f.Citations)
                    {
                        <blockquote class="citation @(c.Verified ? "" : "unverified")">
                            „@c.Quote”
                            <footer>
                                @if (!string.IsNullOrEmpty(c.Url)) { <a href="@c.Url" target="_blank" rel="noopener">@c.Title</a> } else { @c.Title }
                                @if (c.PublishedOn is not null) { <span> · @c.PublishedOn.Value.ToString("dd.MM.yyyy")</span> }
                                @if (!c.Verified) { <span class="badge warn">cytat niezweryfikowany</span> }
                            </footer>
                        </blockquote>
                    }
                </article>
            }
        </section>
    }

    @if (report.Status == ReportStatus.AiError && items.Count > 0)
    {
        <section class="card">
            <h2>Wykryte wpisy (bez analizy)</h2>
            <ul class="item-list">
                @foreach (var i in items)
                {
                    <li><a href="@i.Url" target="_blank" rel="noopener">@i.Title</a> <span class="muted">· @i.Source · @Date(i.PublishedOn)</span></li>
                }
            </ul>
        </section>
    }

    @if (report.Body.Ignored.Count > 0)
    {
        <details class="card">
            <summary>Pominięte wpisy (@report.Body.Ignored.Count) – sprawdź, czy nic ważnego nie zostało odrzucone</summary>
            <ul class="item-list">
                @foreach (var g in report.Body.Ignored)
                {
                    var item = items.FirstOrDefault(i => i.Id.ToString() == g.ItemId);
                    <li>
                        @if (item is not null) { <a href="@item.Url" target="_blank" rel="noopener">@item.Title</a> } else { <span>wpis @g.ItemId</span> }
                        <span class="muted">– @g.Reason</span>
                    </li>
                }
            </ul>
        </details>
    }

    <details class="card" open="@(sourceProblems.Count > 0)">
        <summary>Stan źródeł: @(report.SourcesState.Count - sourceProblems.Count) z @report.SourcesState.Count bez problemów@(sourceProblems.Count > 0 ? $", {sourceProblems.Count} z uwagami" : "")</summary>
        @if (sourceProblems.Count > 0)
        {
            <ul class="item-list">
                @foreach (var s in sourceProblems)
                {
                    <li><a href="@s.Url" target="_blank" rel="noopener">@s.Name</a>: @(s.Problem ?? s.Warning)</li>
                }
            </ul>
        }
        @foreach (var s in report.SourcesState.Where(s => s.Recoveries.Count > 0))
        {
            <p class="muted">@s.Name: @string.Join(" ", s.Recoveries)</p>
        }
        <p class="muted">Sprawdzone w tym dniu: @report.SourcesState.Count(s => s.CheckedToday) z @report.SourcesState.Count (pozostałe według swojej częstotliwości).</p>
    </details>

    @if (!report.IsEmpty && items.Count > 0 && report.Status != ReportStatus.AiError)
    {
        <details class="card">
            <summary>Wpisy źródłowe w tym raporcie (@items.Count)</summary>
            <ul class="item-list">
                @foreach (var i in items)
                {
                    <li><a href="@i.Url" target="_blank" rel="noopener">@i.Title</a> <span class="muted">· @i.Source · @Date(i.PublishedOn)</span></li>
                }
            </ul>
        </details>
    }

    <p class="muted small">
        Przygotował: @Producer(report.Producer)@(report.Model is not null && report.Model != "sample" ? $" ({report.Model})" : "")
        · @WarsawClock.ToLocal(report.CreatedAt).ToString("dd.MM.yyyy HH:mm")
    </p>
}

@code {
    [Parameter] public string Day { get; set; } = "";

    private sealed record Item(long Id, string Title, string Url, string Source, DateOnly? PublishedOn);

    private Report? report;
    private List<Item> items = [];
    private List<SourceStateEntry> sourceProblems = [];
    private DateOnly? previousDay, nextDay;

    protected override async Task OnParametersSetAsync()
    {
        report = null;
        if (!DateOnly.TryParseExact(Day, "yyyy-MM-dd", out var date)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        report = await db.Reports.AsNoTracking().AsSplitQuery()
            .Include(r => r.Findings).ThenInclude(f => f.Citations)
            .SingleOrDefaultAsync(r => r.Date == date);
        if (report is null) return;

        items = await (from i in db.SourceItems.AsNoTracking()
                       join s in db.Sources on i.SourceId equals s.Id
                       where i.ReportId == report.Id
                       orderby i.PublishedOn descending, i.Id
                       select new Item(i.Id, i.Title, i.Url, s.Name, i.PublishedOn)).ToListAsync();
        sourceProblems = report.SourcesState.Where(s => !s.Ok || s.Warning is not null).ToList();
        previousDay = await db.Reports.Where(r => r.Date < date).OrderByDescending(r => r.Date).Select(r => (DateOnly?)r.Date).FirstOrDefaultAsync();
        nextDay = await db.Reports.Where(r => r.Date > date).OrderBy(r => r.Date).Select(r => (DateOnly?)r.Date).FirstOrDefaultAsync();
    }

    private static string ImportanceHeading(Importance i) => i switch
    {
        Importance.Critical => "Krytyczne",
        Importance.High => "Wysokie",
        Importance.Medium => "Średnie",
        _ => "Niskie",
    };

    private static string Date(DateOnly? d) => d?.ToString("dd.MM.yyyy") ?? "bez daty";

    private static string Producer(string p) => p switch
    {
        "claude" => "Claude",
        "sample" => "generator przykładowy (bez Claude)",
        "system" => "system",
        _ when p.StartsWith("api:") => $"program zewnętrzny ({p[4..]})",
        _ => p,
    };
}
